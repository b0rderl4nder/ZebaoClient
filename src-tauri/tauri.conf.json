{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "泽宝控制端",
  "version": "0.2.0",
  "identifier": "cn.lingzewanchuan.zebao.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "泽宝控制端",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["resources/mujoco-runtime/**/*"]
  }
}
